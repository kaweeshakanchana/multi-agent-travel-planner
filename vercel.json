{
  "version": 2,

  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ],
  "functions": {
    "api/**/*.py": {
      "runtime": "@vercel/python@4.3.0"
    }
  },
  "build": {
    "env": {
      "PYTHON_VERSION": "3.12"
    }
  }
}
